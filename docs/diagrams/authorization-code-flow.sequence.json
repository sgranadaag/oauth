{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "Authorization Code + PKCE Flow",
    "locale": "en",
    "output": "docs/diagrams/authorization-code-flow.html",
    "viewBox": [
      1400,
      864
    ],
    "column_fit": "spread",
    "quality_profile": "showcase"
  },
  "participants": [
    {
      "id": "browser",
      "type": "external",
      "label": "Browser"
    },
    {
      "id": "clientFront",
      "type": "frontend",
      "label": "client-front :3001"
    },
    {
      "id": "authFront",
      "type": "frontend",
      "label": "auth-front :3003"
    },
    {
      "id": "authServer",
      "type": "security",
      "label": "auth-server :3000"
    }
  ],
  "segments": [
    {
      "from": 160,
      "to": 222,
      "label": "1 · Start"
    },
    {
      "from": 236,
      "to": 292,
      "label": "2 · Authorize"
    },
    {
      "from": 306,
      "to": 602,
      "label": "3 · Sign in"
    },
    {
      "from": 616,
      "to": 794,
      "label": "4 · Code exchange"
    }
  ],
  "messages": [
    {
      "id": "start-login",
      "from": "browser",
      "to": "clientFront",
      "y": 180,
      "label": "GET /api/auth/login",
      "variant": "emphasis",
      "note": "creates state, nonce, code_verifier"
    },
    {
      "id": "redirect-authorize",
      "from": "clientFront",
      "to": "browser",
      "y": 210,
      "label": "302 → /oauth/authorize · Set-Cookie oauth_transaction",
      "variant": "return"
    },
    {
      "id": "authorize",
      "from": "browser",
      "to": "authServer",
      "y": 250,
      "label": "GET /oauth/authorize ?client_id, redirect_uri, scope, state, nonce, code_challenge",
      "variant": "emphasis",
      "note": "S256 · stores the authorization request (10 min)"
    },
    {
      "id": "redirect-login",
      "from": "authServer",
      "to": "browser",
      "y": 280,
      "label": "302 → auth-front /login?interaction=<id>",
      "variant": "return"
    },
    {
      "id": "open-login",
      "from": "browser",
      "to": "authFront",
      "y": 320,
      "label": "GET /login?interaction=<id>",
      "variant": "default"
    },
    {
      "id": "get-interaction",
      "from": "authFront",
      "to": "authServer",
      "y": 350,
      "label": "GET /oauth/interactions/:id · x-admin-key",
      "variant": "security"
    },
    {
      "id": "interaction-details",
      "from": "authServer",
      "to": "authFront",
      "y": 380,
      "label": "200 { clientName, scope }",
      "variant": "return"
    },
    {
      "id": "render-form",
      "from": "authFront",
      "to": "browser",
      "y": 410,
      "label": "200 sign-in form",
      "variant": "return"
    },
    {
      "id": "submit-login",
      "from": "browser",
      "to": "authFront",
      "y": 440,
      "label": "POST /api/interactions/:id/login { email, password }",
      "variant": "emphasis"
    },
    {
      "id": "verify",
      "from": "authFront",
      "to": "authServer",
      "y": 470,
      "label": "POST /users/verify · x-admin-key { email, password }",
      "variant": "security"
    },
    {
      "id": "verified",
      "from": "authServer",
      "to": "authFront",
      "y": 500,
      "label": "200 { id, email }",
      "variant": "return",
      "note": "401 for any wrong credential · 403 for a wrong key"
    },
    {
      "id": "accept",
      "from": "authFront",
      "to": "authServer",
      "y": 530,
      "label": "POST /oauth/interactions/:id/accept · x-admin-key { subject, email }",
      "variant": "security",
      "note": "subject = the id the identity provider returned"
    },
    {
      "id": "code-issued",
      "from": "authServer",
      "to": "authFront",
      "y": 560,
      "label": "200 { redirectTo: redirect_uri?code&state }",
      "variant": "return",
      "note": "request claimed · code valid 120 s"
    },
    {
      "id": "login-result",
      "from": "authFront",
      "to": "browser",
      "y": 590,
      "label": "200 { redirectTo }",
      "variant": "return"
    },
    {
      "id": "callback",
      "from": "browser",
      "to": "clientFront",
      "y": 630,
      "label": "GET /api/auth/callback?code&state",
      "variant": "emphasis",
      "note": "state checked against the cookie"
    },
    {
      "id": "token",
      "from": "clientFront",
      "to": "authServer",
      "y": 660,
      "label": "POST /oauth/token · Basic client_id:secret · code, redirect_uri, code_verifier",
      "variant": "security"
    },
    {
      "id": "tokens",
      "from": "authServer",
      "to": "clientFront",
      "y": 690,
      "label": "200 { access_token, refresh_token, id_token }",
      "variant": "return",
      "note": "code burned first · PKCE + redirect_uri checked"
    },
    {
      "id": "jwks",
      "from": "clientFront",
      "to": "authServer",
      "label": "GET /oauth/jwks",
      "variant": "default",
      "y": 720
    },
    {
      "id": "jwks-keys",
      "from": "authServer",
      "to": "clientFront",
      "label": "200 { keys: [{ kid, n, e }] }",
      "variant": "return",
      "note": "RS256 signature checked by kid, then iss, aud, exp, nonce",
      "y": 750
    },
    {
      "id": "session",
      "from": "clientFront",
      "to": "browser",
      "y": 780,
      "label": "302 → / · Set-Cookie session",
      "variant": "return",
      "note": "the session never holds the refresh token"
    }
  ],
  "activations": [
    {
      "participant": "clientFront",
      "from": 175,
      "to": 215,
      "type": "frontend"
    },
    {
      "participant": "authServer",
      "from": 245,
      "to": 285,
      "type": "security"
    },
    {
      "participant": "authFront",
      "from": 315,
      "to": 415,
      "type": "frontend"
    },
    {
      "participant": "authServer",
      "from": 345,
      "to": 385,
      "type": "security"
    },
    {
      "participant": "authFront",
      "from": 435,
      "to": 595,
      "type": "frontend"
    },
    {
      "participant": "authServer",
      "from": 465,
      "to": 505,
      "type": "security"
    },
    {
      "participant": "authServer",
      "from": 525,
      "to": 565,
      "type": "security"
    },
    {
      "participant": "clientFront",
      "from": 625,
      "to": 785,
      "type": "frontend"
    },
    {
      "participant": "authServer",
      "from": 655,
      "to": 695,
      "type": "security"
    },
    {
      "participant": "authServer",
      "from": 715,
      "to": 755,
      "type": "security"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Through the browser",
      "items": [
        "state, nonce and code_challenge go out in the authorize URL",
        "The code comes back in the URL, useless without the verifier",
        "auth-front only ever receives an interaction id"
      ]
    },
    {
      "dot": "rose",
      "title": "Server to server",
      "items": [
        "client_secret and code_verifier only travel in POST /oauth/token",
        "The password reaches /users/verify only, never /oauth",
        "One provider key opens /users/verify and the interaction endpoints"
      ]
    },
    {
      "dot": "amber",
      "title": "Single use",
      "items": [
        "Issuing the code deletes the authorization request",
        "The code is spent before its checks run",
        "The transaction cookie is deleted on callback"
      ]
    }
  ]
}
