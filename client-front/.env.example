# This app is a PUBLIC client: everything here reaches the browser, so there
# is no client secret. PKCE is what protects the code exchange instead.
NEXT_PUBLIC_AUTH_SERVER_URL=http://localhost:3000
NEXT_PUBLIC_OAUTH_ISSUER=http://localhost:3000
NEXT_PUBLIC_OAUTH_CLIENT_ID=
# Must be registered on the client, exactly, in auth-server
NEXT_PUBLIC_OAUTH_REDIRECT_URI=http://localhost:3001/callback
NEXT_PUBLIC_OAUTH_SCOPE=read write
